# ============================================================
# Blade X — .gitignore
# ============================================================

# --- Secrets (NEVER commit) ---
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# --- Node ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo

# --- Build output ---
dist/
build/
out/

# --- Runtime data (contains user data + media files) ---
data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# --- Media Show storage (user media, never commit) ---
data/media-show/

# --- Logs ---
logs/
*.log
npm-debug.log*

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Editors ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- Test / coverage ---
coverage/
.nyc_output/
.nyc_output

# --- Temporary ---
tmp/
temp/
.cache/
*.tmp

# --- Keep these (documented exceptions) ---
!assets/
!public/
!src/
!.env.example
!package.json
!package-lock.json
!tsconfig.json
!README.md